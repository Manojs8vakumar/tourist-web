# ============================================================
# PLAN MY TRIP AGENCY - ENVIRONMENT CONFIGURATION
# ============================================================

# Google Gemini API Key (for conversational AI travel chatbot & intelligent itinerary generator)
# Obtain from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenWeatherMap API Key (for live real-time meteorological data)
# Obtain from: https://home.openweathermap.org/api_keys
# Note: An automatic Open-Meteo live API fallback operates seamlessly even if this key is blank!
VITE_OPENWEATHER_API_KEY=

# Unsplash API Access Key (for dynamic travel photography search)
# Obtain from: https://unsplash.com/developers
# Note: Dynamic high-res Unsplash CDN fallback operates seamlessly even if this key is blank!
VITE_UNSPLASH_ACCESS_KEY=
